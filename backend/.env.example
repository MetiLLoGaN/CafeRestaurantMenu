PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
FRONTEND_URL=http://localhost:3000

# ── Super Admin provisioning (used by `npm run super-admin`) ────────
# The first Super Admin account is created offline, never via an API.
# Keep these secret; the script is safe to rerun and will not reset an
# existing super admin's password.
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=change_me_strong_password